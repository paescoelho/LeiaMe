ALLOWED_ORIGINS=https://paescoelho.github.io,http://localhost:8080,http://127.0.0.1:8080
# Set true to reflect any Origin in CORS responses (use with care in production).
ALLOW_ANY_ORIGIN=false
TRANSLATE_TARGET_LANG=pt
AUTH_SECRET=change-me-long-random
AUTH_TOKEN_TTL_SECONDS=604800

# Optional phrase MP3 synthesis; the browser still handles documents and layout.
TTS_ENABLED=true
TTS_MAX_SESSIONS=2
TTS_SESSION_LEASE_SECONDS=180
# Starting container budget; adjust for your voices and simultaneous readers.
SERVER_MEMORY_LIMIT=1g

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=paescoelho@gmail.com
SMTP_PASS=senha-de-app-do-gmail
SMTP_FROM=LeiaMe - Rodrigo Paes Coelho Santana <paescoelho@gmail.com>

APP_NAME=LeiaMe
PUBLIC_APP_URL=https://paescoelho.github.io/LeiaMe/

# Reading summary emails use the same SMTP account as password recovery.
# Hours are evaluated in each user's browser-reported IANA timezone.

# Daily reading reminders are opt-in per account in Settings.
