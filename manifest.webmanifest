{
    "id": "./index.html",
    "name": "LeiaMe",
    "description": "Leitor de PDF e EPUB com voz local",
    "short_name": "LeiaMe",
    "categories": [
        "education",
        "productivity"
    ],
    "start_url": "./index.html",
    "scope": "./",
    "scope_extensions": [
        {
            "type": "origin",
            "origin": "https://paescoelho.github.io/LeiaMe/"
        }
    ],
    "edge_side_panel": {},
    "launch_handler": {
        "client_mode": "auto"
    },
    "protocol_handlers": [],
    "lang": "en",
    "dir": "ltr",
    "display": "fullscreen",
    "background_color": "#1a1816",
    "theme_color": "#2f6f66",
    "prefer_related_applications": true,
    "display_override": [
        "fullscreen"
    ],
    "orientation": "any",
    "icons": [
        {
            "src": "assets/icons/icon.svg",
            "sizes": "any",
            "type": "svg"
        },
        {
            "src": "assets/icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "assets/icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png"
        },
        {
            "src": "assets/icons/mask-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "related_applications": [],
    "screenshots": [
        {
            "src": "assets/screenshots/screenshot1.png",
            "sizes": "1920x1080",
            "type": "image/png",
            "form_factor": "wide"
        },
        {
            "src": "assets/screenshots/screenshot2.png",
            "sizes": "1080x2400",
            "type": "image/png",
            "form_factor": "narrow"
        }
    ]
}
